{
  "name": "easyBank",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "prepare": "husky",
    "postinstall": "patch-package",
    "env:dev": "shx cp .env.dev .env",
    "env:uat": "shx cp .env.uat .env",
    "env:prod": "shx cp .env.prod .env",
    "android:dev": "npm run env:dev && react-native run-android --active-arch-only --mode=DevDebug",
    "android:uat": "npm run env:uat && react-native run-android --active-arch-only --mode=UATDebug",
    "android:prod": "npm run env:prod && react-native run-android --active-arch-only --mode=PRODDebug",
    "android:dev:release": "npm run env:dev && react-native run-android --mode=DevRelease",
    "android:uat:release": "npm run env:uat && react-native run-android --mode=UatRelease",
    "android:prod:release": "npm run env:prod && react-native run-android --mode=ProdRelease",
    "build:android:dev": "npm run env:dev && cd android && ./gradlew assembleDevRelease",
    "build:android:uat": "npm run env:uat && cd android && ./gradlew assembleUatRelease",
    "build:android:prod": "npm run env:prod && cd android && ./gradlew assembleProdRelease",
    "bundle:android:dev": "npm run env:dev && cd android && ./gradlew bundleDevRelease",
    "bundle:android:uat": "npm run env:uat && cd android && ./gradlew bundleUatRelease",
    "bundle:android:prod": "npm run env:prod && cd android && ./gradlew bundleProdRelease",
    "ios:dev": "npm run env:dev && react-native run-ios --scheme EasyBank_DEV --mode DevDebug",
    "ios:uat": "npm run env:uat && react-native run-ios --scheme EasyBank_UAT --mode UatDebug",
    "ios:prod": "npm run env:prod && react-native run-ios --scheme EasyBank --mode ProdDebug"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.88.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
